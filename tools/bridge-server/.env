PORT=3001
CORS_ORIGIN=*
# PLY tagged with opacity=+100 (selected) / -100 (non-selected).
# splat-transform keeps only gaussians where sigmoid(opacity_raw) > 0.5.
# Legacy single-step mode (reference):
# MASK_CLI_CMD=splat-transform -w {input} -V opacity,gt,0.5 {output}

# Pipeline mode (recommended):
# 1) Keep only points intersecting the cone selection volume
SELECT_CLI_CMD=node ./scripts/select-cone.mjs --overwrite --input {input} --output {selected}
# Cone parameters for select-cone.mjs
# Option A (deterministic quick test): auto-derive apex/axis from first points (guarantees intersection)
SELECT_CONE_AUTO_FROM_DATA=true
# Option B (manual): set AUTO=false and fill values below
SELECT_CONE_APEX=
SELECT_CONE_AXIS=
SELECT_CONE_ANGLE_DEG=30
SELECT_CONE_RANGE=5
# 2) Optional cleanup to remove floaters from the selected cloud
MASK_CLI_CMD=node ../../splat-transform/bin/cli.mjs -w {selected} -G 0.05,0.1,0.004 {masked}
# 3) Export final output
EXPORT_CLI_CMD=node ../../splat-transform/bin/cli.mjs -w {masked} {output}

MASK_CLI_CWD=
MASK_MAX_PAYLOAD_MB=500
MASK_EXEC_TIMEOUT_MS=120000
MASK_EXEC_MAX_BUFFER_MB=20
MASK_OUTPUT_SUFFIX=_output
MASK_OUTPUT_EXT=.ply
MASK_KEEP_TEMP=false
