PORT=3001
CORS_ORIGIN=*
# PLY tagged with opacity=+100 (selected) / -100 (non-selected).
# splat-transform keeps only gaussians where sigmoid(opacity_raw) > 0.5.
# Legacy single-step mode:
# MASK_CLI_CMD=splat-transform -w {input} -V opacity,gt,0.5 {output}

# Pipeline mode (recommended):
SELECT_CLI_CMD=splat-transform -w {input} -V opacity_raw,gt,0 {selected}
MASK_CLI_CMD=splat-transform -w {selected} -G 0.05,0.1,0.004 {masked}
EXPORT_CLI_CMD=splat-transform -w {masked} {output}

MASK_CLI_CWD=
MASK_MAX_PAYLOAD_MB=500
MASK_EXEC_TIMEOUT_MS=120000
MASK_EXEC_MAX_BUFFER_MB=20
MASK_OUTPUT_SUFFIX=_output
MASK_OUTPUT_EXT=.ply
MASK_KEEP_TEMP=false
